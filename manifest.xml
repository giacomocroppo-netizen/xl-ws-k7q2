        <bt:Image id="exc.32" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/icon-exc-32.png"/>
        <bt:Image id="exc.80" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/icon-exc-80.png"/>
        <bt:Image id="del.16" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/icon-del-16.png"/>
        <bt:Image id="del.32" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/icon-del-32.png"/>
        <bt:Image id="set.16" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/icon-set-16.png"/>
        <bt:Image id="set.32" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/icon-set-32.png"/>
        <bt:Image id="set.80" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/icon-set-80.png"/>
        <bt:Image id="del.80" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/icon-del-80.png"/>
        <bt:Image id="imp.16" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/icon-imp-16.png"/>
        <bt:Image id="imp.32" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/icon-imp-32.png"/>
        <bt:Image id="imp.80" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/icon-imp-80.png"/>
        <bt:Image id="org.16" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/icon-org-16.png"/>
        <bt:Image id="org.32" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/icon-org-32.png"/>
        <bt:Image id="org.80" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/icon-org-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Snipper.Url" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/"/>
        <bt:Url id="Snipper.Taskpane.Url" DefaultValue="https://giacomocroppo-netizen.github.io/snipper/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Snipper.GetStarted.Title" DefaultValue="Snipper è pronto"/>
        <bt:String id="Snipper.Group.Label" DefaultValue="Snipper"/>
