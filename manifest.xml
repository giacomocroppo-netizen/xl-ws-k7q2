      <bt:LongStrings>
        <bt:String id="Snipper.GetStarted.Desc" DefaultValue="Apri il pannello Snipper dalla scheda Home."/>
        <bt:String id="Snipper.Button.Tip" DefaultValue="Apre il pannello per spuntare documenti (SNIP, SUM SNIP)."/>
        <bt:String id="Snipper.Snip.Tip" DefaultValue="Snip: legge il valore e lo scrive nella cella"/>
        <bt:String id="Snipper.Sum.Tip" DefaultValue="Sum Snip: somma più valori"/>
        <bt:String id="Snipper.Val.Tip" DefaultValue="Validation Snip: cella verde con ✓"/>
        <bt:String id="Snipper.Exc.Tip" DefaultValue="Exception Snip: cella rossa con ✗"/>
        <bt:String id="Snipper.Del.Tip" DefaultValue="Elimina in modo definitivo lo snip della cella selezionata"/>
        <bt:String id="Snipper.OpenButton.Tip" DefaultValue="Apre il pannello Snipper con i documenti."/>
        <bt:String id="Snipper.Import.Tip" DefaultValue="Importa PDF e immagini nel file Excel (anche trascinandoli)."/>
        <bt:String id="Snipper.Organizer.Tip" DefaultValue="Organizza documenti, cartelle, elenco snip, OCR e compressione."/>
        <bt:String id="Snipper.Settings.Tip" DefaultValue="Impostazioni, OCR su tutti i documenti e compressione."/>
